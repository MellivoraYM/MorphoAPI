# Copy to /etc/morpho-api/env and edit

# MySQL
MYSQL_URL="mysql+pymysql://<user>:<password>@127.0.0.1:3306/morpho"

# Scheduler control (set per service)
SCHEDULER_ENABLED=false

# Morpho endpoints (optional)
MORPHO_GRAPHQL_URL="https://api.morpho.org/graphql"
MORPHO_REWARDS_URL="https://rewards.morpho.org/v1"

# RPC (optional)
ETH_RPC_URL="wss://ethereum-rpc.publicnode.com"
ARB_RPC_URL="https://public-arb-mainnet.fastnode.io"
BASE_RPC_URL="https://base.drpc.org"

